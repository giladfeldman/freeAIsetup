{
  // MetaScience course in the browser (GitHub Codespaces), for students without a laptop (e.g. iPad only).
  // It runs the SAME setup script as on a Mac or Linux laptop (setup-mac.sh), so tools, R and Python packages,
  // course folder and AI settings match the other students. Usage is billed to the student's own free
  // GitHub allowance, never to the owner of this repository.
  "name": "MetaScience course",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/rocker-org/devcontainer-features/r-apt:latest": { "vscodeRSupport": "none", "installRMarkdown": false },
    "ghcr.io/rocker-org/devcontainer-features/rstudio-server:latest": { "singleUser": true }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "containerEnv": { "METASCIENCE_DIR": "/workspaces/MetaScience" },
  "postCreateCommand": "bash .devcontainer/create.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [4000, 4096, 8787],
  // The start page: START-HERE.md (opened first) has a one-tap link to it (http://localhost:4000/, which the Codespace
  // turns into the start page's own address), and a box with an "Open in Browser" button offers it as well.
  // Not "openPreview": the preview inside the window is refused by Firefox and Safari (iPad) because the private
  // port's sign-in runs through github.com, which may not be shown inside another page (real Codespace 2026-11-13).
  // Not "openBrowser": a tablet's pop-up blocker stops a tab opened without a tap. Its buttons open OpenCode and
  // RStudio in new tabs, so those two stay silent.
  "portsAttributes": {
    "4000": { "label": "Start page (tap here)", "onAutoForward": "notify" },
    "4096": { "label": "OpenCode (AI assistant)", "onAutoForward": "silent" },
    "8787": { "label": "RStudio", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["START-HERE.md"] },
    "vscode": {
      // no R editor extension (it pops up errors, and students use RStudio in the browser instead).
      // The "Do you trust the authors" box cannot be set from here, so START-HERE explains it. START-HERE.md opens as a
      // page with a one-tap link to the start page through .vscode/settings.json: the browser editor ignores that
      // setting here (real Codespace 2026-11-09) but applies it from the workspace file (2026-11-15).
      "settings": { "workbench.startupEditor": "none" },
      "extensions": ["-REditorSupport.r"]
    }
  }
}
